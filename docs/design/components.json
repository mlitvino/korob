      "canvasOnly": ["label"],
      "codeOnly": ["occurredAt"]
    },
    "TransactionItem": {
      "code": ["frontend/src/features/transaction-list/components/TransactionItem.tsx"],
      "shared": ["selecting", "selected"],
      "canvasOnly": ["kind", "time", "category", "amount", "href"],
      "codeOnly": ["transaction", "onPress", "onLongPress"]
    },
    "FieldInput": {
      "code": ["frontend/src/components/Field.tsx"],
      "shared": ["label", "placeholder", "value", "error", "multiline", "maxLength"],
