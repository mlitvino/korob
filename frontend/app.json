{
  "expo": {
    "name": "Korob",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/korob_logo.png",
    "scheme": "korob",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mlitvino.korob",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.mlitvino.korob",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#782DCC",
        "foregroundImage": "./src/assets/images/korob_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/korob_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#782DCC",
          "dark": {
            "backgroundColor": "#782DCC"
          }
        }
      ],
      "expo-localization",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d7c1bbf-58d2-44e0-8d24-11ffc75329f3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3d7c1bbf-58d2-44e0-8d24-11ffc75329f3"
    }
  }
}
